<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- SIRENBERT dev-only: foreground service for the long bulk on-device replay. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application>
        <!-- SIRENBERT dev reset hook. Trigger from PowerShell with:
                 adb shell am broadcast -a io.element.android.x.debug.SIRENBERT_RESET
             Exported so adb can reach it. No special permission required. -->
        <receiver
            android:name="io.element.android.features.messages.impl.sirenbert.SirenbertResetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.element.android.x.debug.SIRENBERT_RESET" />
                <action android:name="io.element.android.x.debug.SIRENBERT_EXPORT" />
                <action android:name="io.element.android.x.debug.SIRENBERT_BULK_REPLAY" />
            </intent-filter>
        </receiver>

        <!-- SIRENBERT dev-only foreground service that runs the full bulk
             on-device replay over the held-out test set without OS suspension. -->
        <service
            android:name="io.element.android.features.messages.impl.sirenbert.SirenbertBulkReplayService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- SIRENBERT cross-app (Pattern B, "system Smart Reply" style, NO root):
             reads message notifications from ALL apps once the user grants "Notification access"
             in Settings, and feeds them to the same on-device engine. -->
        <service
            android:name="io.element.android.features.messages.impl.sirenbert.SirenbertNotificationListenerService"
            android:exported="false"
            android:label="SIRENBERT scam detection"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
